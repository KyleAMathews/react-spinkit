{
  // Builds the library (src/ -> dist/) as CommonJS with type declarations.
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2020", "dom", "dom.iterable"],
    "module": "node20",
    "jsx": "react",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
